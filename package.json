{
  "name": "gitwikitree",
  "productName": "Git Wikitree",
  "version": "1.0.0",
  "description": "A desktop Git file workspace built with Electron, React, and TypeScript",
  "main": "./out/main/index.js",
  "author": "miclle",
  "homepage": "https://github.com/miclle/gitwikitree",
  "scripts": {
    "format": "prettier --write .",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "prepare:electron-dev": "node scripts/prepare-electron-dev-icon.mjs",
    "start": "electron-vite preview",
    "predev": "npm run prepare:electron-dev",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && npm run prepare:electron-dev",
    "build:unpack": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "build:mac:intel": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64",
    "build:mac:arm64": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "build:mac:release": "node scripts/build-macos-release.mjs",
    "build:mac:intel:release": "npm run build && electron-builder --mac --x64 -c.mac.notarize=true -c.publish.channel=latest-x64",
    "build:mac:arm64:release": "npm run build && electron-builder --mac --arm64 -c.mac.notarize=true -c.publish.channel=latest-arm64",
    "verify:mac:release": "node scripts/verify-macos-release.mjs",
    "verify:mac:intel:release": "node scripts/verify-macos-release.mjs --arch x64",
    "verify:mac:arm64:release": "node scripts/verify-macos-release.mjs --arch arm64",
    "build:linux": "npm run build && electron-builder --linux",
    "build:linux:release": "npm run build && electron-builder --linux AppImage deb --x64"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lezer/highlight": "^1.2.3",
    "@marp-team/marp-core": "^4.3.0",
    "@tabler/icons-react": "^3.44.0",
    "@uiw/react-codemirror": "^4.25.10",
    "dompurify": "^3.4.7",
    "electron-updater": "^6.8.9",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "i18next": "^26.3.0",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.4",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "^5.7.284",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "material-icon-theme": "5.35.0",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.3"
  }
}
